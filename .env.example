# Podsync Manager Environment Variables Template
# Copy this file to .env and adjust the values for your environment.

# Server Port (default: 3000)
PORT=3000

# Podsync config.toml file path (required in container or custom host setup)
PODSYNC_CONFIG_PATH=/app/config/config.toml

# Target Podsync Docker Container Name (default: podsync)
# PODSYNC_CONTAINER_NAME=podsync

# YouTube Data API v3 Key (for episode preview and metadata lookup)
PODSYNC_YOUTUBE_API_KEY=your_youtube_api_key_here

# Administrator Credentials (default: admin / admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
SESSION_SECRET=generate_a_long_random_string_for_cookie_signing

# S3 / Cloudflare R2 Storage Credentials (optional, if using S3 storage without config.toml inline keys)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
